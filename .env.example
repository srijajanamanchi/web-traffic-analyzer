# ==============================================================================
# Real-Time Web Traffic Analyzer - Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT REAL SECRETS OR VALUES TO VERSION CONTROL.
# Copy this file to .env for local development:
#   cp .env.example .env
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Collector & API Service
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# Database Configuration (PostgreSQL with SQLite fallback for local test/dev)
DATABASE_URL=sqlite:///./traffic.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://traffic_user:placeholder_password@db:5432/traffic_db

POSTGRES_USER=traffic_user
POSTGRES_PASSWORD=placeholder_secure_password
POSTGRES_DB=traffic_db
POSTGRES_PORT=5432

# Redis Cache & Aggregation (Optional for local, enabled in prod compose)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Demo Site Configuration
DEMO_SITE_PORT=8080
DEMO_SITE_URL=http://localhost:8080

# Log Tailing Configuration
NGINX_LOG_PATH=/var/log/nginx/access.log
TAIL_NGINX_LOGS=false

# Anomaly Detection Baseline
Z_SCORE_THRESHOLD=2.5
ROLLING_WINDOW_MINUTES=15
ERROR_RATE_SURGE_THRESHOLD=0.15

# Observability & Alerts
PROMETHEUS_METRICS_ENABLED=true
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/PLACEHOLDER/WEBHOOK/URL
ALERT_NOTIFICATION_CHANNEL=discord_or_slack

# CI/CD Deployment Settings (Referenced by GitHub Actions Secrets)
SSH_HOST=placeholder.ec2.amazonaws.com
SSH_USER=ubuntu
SSH_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----\nPLACEHOLDER\n-----END OPENSSH PRIVATE KEY-----
DOCKER_REGISTRY=ghcr.io
